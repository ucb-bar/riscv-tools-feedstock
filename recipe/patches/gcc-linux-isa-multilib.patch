From: riscv-tools-feedstock
Subject: Keep Linux GCC multilibs separate by ISA

Keep the established Linux GCC paths for existing scalar multilibs and add a
distinct directory for the vector runtime.  The rv64gcv alias reuses the
canonical rv64imafdcv runtime variant.

--- a/config/riscv/t-linux
+++ b/config/riscv/t-linux
@@ -1,3 +1,8 @@
-# Only XLEN and ABI affect Linux multilib dir names, e.g. /lib32/ilp32d/
-MULTILIB_DIRNAMES := $(patsubst rv32%,lib32,$(patsubst rv64%,lib64,$(MULTILIB_DIRNAMES)))
-MULTILIB_OSDIRNAMES := $(patsubst lib%,../lib%,$(MULTILIB_DIRNAMES))
+# Preserve the established Linux paths for scalar multilibs.  Give only the
+# vector variant a distinct directory so rv64gc and rv64gcv with lp64d cannot
+# overwrite one another.  Map the alias and canonical spelling first, before
+# the remaining rv64 directories are collapsed to lib64.
+MULTILIB_DIRNAMES := $(patsubst rv64imafdcv,lib64/rv64imafdcv,$(MULTILIB_DIRNAMES))
+MULTILIB_DIRNAMES := $(patsubst rv64gcv,lib64/rv64imafdcv,$(MULTILIB_DIRNAMES))
+MULTILIB_DIRNAMES := $(patsubst rv32%,lib32,$(patsubst rv64%,lib64,$(MULTILIB_DIRNAMES)))
+MULTILIB_OSDIRNAMES := $(patsubst lib%,../lib%,$(MULTILIB_DIRNAMES))
+
 MULTIARCH_DIRNAME := $(call if_multiarch,$(firstword $(subst -, ,$(target)))-linux-gnu)
--- a/config/riscv/t-linux-multilib
+++ b/config/riscv/t-linux-multilib
@@ -3 +3 @@
-MULTILIB_OPTIONS = march=rv32imac/march=rv32ima/march=rv32imaf/march=rv32imafd/march=rv32imafc/march=rv32imafdc/march=rv32g/march=rv32gc/march=rv64imac/march=rv64ima/march=rv64imaf/march=rv64imafd/march=rv64imafc/march=rv64imafdc/march=rv64g/march=rv64gc mabi=ilp32/mabi=ilp32d/mabi=lp64/mabi=lp64d
+MULTILIB_OPTIONS = march=rv32imac/march=rv32ima/march=rv32imaf/march=rv32imafd/march=rv32imafc/march=rv32imafdc/march=rv32g/march=rv32gc/march=rv64imac/march=rv64ima/march=rv64imaf/march=rv64imafd/march=rv64imafc/march=rv64imafdc/march=rv64g/march=rv64gc/march=rv64imafdcv/march=rv64gcv mabi=ilp32/mabi=ilp32d/mabi=lp64/mabi=lp64d
@@ -19 +19,3 @@
-rv64gc ilp32 \
+rv64gc \
+rv64imafdcv \
+rv64gcv ilp32 \
@@ -26 +26,2 @@
-march=rv64imafdc/mabi=lp64d
+march=rv64imafdc/mabi=lp64d \
+march=rv64imafdcv/mabi=lp64d
@@ -46 +46,2 @@
-march.rv64imafdc/mabi.lp64d=march.rv64g/mabi.lp64d
+march.rv64imafdc/mabi.lp64d=march.rv64g/mabi.lp64d \
+march.rv64imafdcv/mabi.lp64d=march.rv64gcv/mabi.lp64d
